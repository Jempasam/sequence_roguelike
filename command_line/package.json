{
    "name": "@game/command_line",
    "version": "0.0.0",
    "private": true,
    "type": "module",
    "exports": {
        "./convert": "./src/convert.ts",
        "./sim": "./src/sim/index.ts"
    },
    "scripts": {
        "build": "esbuild src/main.ts src/sim/worker.ts --bundle --platform=node --format=esm --target=node20 --outdir=dist --entry-names=[name] --out-extension:.js=.mjs --log-level=warning",
        "start": "npm run build --silent && node dist/main.mjs",
        "start:tsx": "tsx src/main.ts",
        "typecheck": "tsc -p ."
    },
    "dependencies": {
        "@game/core": "*"
    },
    "devDependencies": {
        "@types/node": "^24.19.2",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15"
    }
}
