{
    "size": [816, 444],
    "render": {
        "light": 270,
        "steps": [
            "occlusion",
            "shadow",
            "reflection",
            {"id": "contrast", "between": 0.7, "towards": "#5a5a4a"},
            "alpha_thickness",
            {"id": "outer_outline", "different_mat": true},
            "casted_shadow",
            "gloom",
            "smooth",
            {"id": "tint", "color": "#4a7a30", "amount": 0.1}
