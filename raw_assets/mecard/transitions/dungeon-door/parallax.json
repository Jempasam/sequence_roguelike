        "door:   a=1 > hold > hold m > a=0.5 > a=0 > hold > hold",
        "dark:   a=1 > hold > hold m > hold > hold > a=0 > hold"
    ],
    "layers": [
        {"name": "leaf", "tag": "object", "picture": "leaf.pic.json", "at": [0, 0]},
        {"name": "door", "tag": "object", "picture": "door.pic.json", "at": [0, 0]},
        {"name": "torch", "tag": "object", "picture": "torch.pic.json", "at": [0, 0]},
        {"name": "wall", "tag": "border", "picture": "wall.pic.json", "at": [0, 0]},
        {"name": "dark", "tag": "border", "picture": "dark.pic.json", "at": [0, 0]}
    ]
