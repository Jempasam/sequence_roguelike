{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        "types": [],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
        "noFallthroughCasesInSwitch": true,
        "noImplicitOverride": true,
        "isolatedModules": true,
        "allowArbitraryExtensions": true,
        "rootDirs": [".", ".generated"],
        "verbatimModuleSyntax": true,
        "skipLibCheck": true,
        "noEmit": true
    }
}
